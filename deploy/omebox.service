[Unit]
Description=OmeBox FastAPI application
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=omebox
Group=omebox
WorkingDirectory=/opt/omebox
EnvironmentFile=/opt/omebox/.env
Environment=PYTHONUNBUFFERED=1
Environment=WEB_CONCURRENCY=2
ExecStart=/opt/omebox/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2 --no-access-log
Restart=always
RestartSec=5
MemoryMax=3G
LimitNOFILE=65536

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/omebox/uploads /opt/omebox/cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
