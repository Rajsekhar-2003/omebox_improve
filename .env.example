# Copy to .env and replace EVERY placeholder. Never commit the real .env.

# Security (generate with the commands below)
#   openssl rand -hex 32
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ADMIN_API_KEY=replace-with-a-separate-random-token

# Database (local MongoDB on the VPS)
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=sharebin

# Public URL: set this to avoid Host-header poisoning in generated links
BASE_URL=https://omebox.com
FORCE_HTTPS=1
# systemd + local nginx: 127.0.0.1
# Docker + host nginx: also add the bridge gateway (usually 172.17.0.1)
TRUSTED_PROXIES=127.0.0.1,172.17.0.1

# Local storage
UPLOAD_DIR=/opt/omebox/uploads
CACHE_DIR=/opt/omebox/cache

# Limits
MAX_FILE_SIZE=104857600
MAX_SHARE_SIZE=524288000
MAX_TEXT_LENGTH=200000
MAX_FILES_PER_SHARE=20
RATE_LIMIT=200/minute
UPLOAD_RATE_LIMIT=20/minute
VERIFY_RATE_LIMIT=10/minute
ACCESS_RATE_LIMIT=5/minute
ADMIN_RATE_LIMIT=30/minute
CLEANUP_RATE_LIMIT=5/minute
# Older deployments used FILE_UPLOAD_RATE_LIMIT / ADMIN_TOKEN / WORKERS.
# Those names are still accepted but deprecated; rename them when you rotate keys.

# Bcrypt cost (10 is a good balance on 4 GB RAM)
BCRYPT_ROUNDS=10

# Automatic cleanup: expired shares + orphan/temp files
CLEANUP_ENABLED=1
CLEANUP_INTERVAL_MINUTES=5
CLEANUP_LOCK_TTL_SECONDS=600
ORPHAN_GRACE_MINUTES=30
PART_FILE_MAX_AGE_MINUTES=60
CACHE_MAX_AGE_MINUTES=1440

# Mongo pool sized for a 4 GB VPS
MONGO_MAX_POOL_SIZE=30
MONGO_MIN_POOL_SIZE=2

# Optional hardening
ENABLE_DOCS=0
ALLOWED_ORIGINS=https://omebox.com,https://www.omebox.com
LOG_LEVEL=INFO
